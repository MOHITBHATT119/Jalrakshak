WATSONX_PROJECT_ID=42804282-58f3-4a1f-b387-9e415c0c04ae
WATSONX_API_KEY=
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small
DEMO_MODE=false

# ── Admin authentication (Task 1.2) ──────────────────────────────────────────
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_IN_PROD_jalrakshak_2024_secret
ADMIN_USERNAME=admin
# Set ONE of the following:
#   ADMIN_PASSWORD      plain text (hashed at startup — local dev only)
#   ADMIN_PASSWORD_HASH pre-bcrypt-hashed value (recommended for production)
ADMIN_PASSWORD=jalrakshak2024
# ADMIN_PASSWORD_HASH=$2b$12$...

# ── Government data feed (Task 1.1) ──────────────────────────────────────────
# Register free at https://api.data.gov.in → My Account → API Key
DATA_GOV_API_KEY=
# Override the default IMD Gujarat rainfall resource (optional)
# DATA_GOV_RAINFALL_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# ── Persistent Postgres DB (Task 1.3) ────────────────────────────────────────
# Create a free DB at https://neon.tech (no credit card needed)
# Copy the connection string from the Neon dashboard and paste below.
# Without this, the app falls back to ephemeral SQLite (data lost on restart).
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── CORS extra origins (comma-separated) ─────────────────────────────────────
# CORS_ORIGINS=https://jalrakshak.vercel.app,https://jalrakshak.onrender.com
